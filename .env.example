# Nevo frontend environment variables.
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.

# Base URL of the FastAPI backend the API client talks to (src/lib/api/client.ts).
# NEXT_PUBLIC_* is exposed to the browser — never put a secret behind this prefix.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated origins (LAN IPs / hostnames) allowed to reach the dev server
# cross-origin — e.g. your computer's Wi-Fi IP for testing on a phone. Dev-only
# (Next.js `allowedDevOrigins`); unset means localhost-only.
# ALLOWED_DEV_ORIGINS=192.168.1.23,192.168.1.24
# Public origin, used for metadataBase (canonical + OG/Twitter image URLs),
# robots.txt and sitemap.xml. MUST be set per environment - it is read at
# BUILD time, so changing it requires a redeploy. Production:
# NEXT_PUBLIC_SITE_URL=https://www.nevolearning.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
